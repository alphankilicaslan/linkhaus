<footer class="lh-footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <span class="font-display footer-brand">LINKHAUS</span>
      <span class="font-mono footer-company">BY HELIOS SMART SYSTEMS</span>
    </div>

    <div class="footer-right font-mono">
      <span>LOCAL CORE // 127.0.0.1:8080</span>
      <span>PORT 4321</span>
    </div>
  </div>
</footer>

<style>
  .lh-footer {
    padding: 2.25rem 0;
    background-color: var(--bg);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer-left {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }

  .footer-brand {
    font-weight: 600;
    letter-spacing: 0.16em;
    font-size: 0.9rem;
  }

  .footer-company,
  .footer-right {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
  }

  .footer-right {
    display: flex;
    gap: 1.5rem;
  }
</style>
