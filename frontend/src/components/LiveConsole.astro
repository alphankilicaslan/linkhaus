  }

  .lh-modal {
    width: 100%;
    max-width: 520px;
    max-height: 90vh;
    overflow-y: auto;
    background-color: var(--bg-modal);
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    border: 1px solid var(--border-strong);
    border-radius: 24px;
    box-shadow: var(--shadow-card);
    padding: 1.65rem;
    display: flex;
    flex-direction: column;
