  }

  :global(.pill-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    border: 1px solid var(--border-strong);
    background-color: var(--bg-subtle);
    color: var(--fg);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    cursor: pointer;
    transition: all 0.2s var(--ease-spring);
  }

  :global(.pill-btn:hover) {
