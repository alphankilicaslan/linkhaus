---
---

<section id="console" class="console-section">
  <div class="container">
    <div class="section-head" data-reveal>
      <div>
        <span class="section-label">01 // TELEMETRY &amp; CONTROL</span>
        <h2 class="section-title font-display">Live Architectural Console</h2>
      </div>
      <div class="head-controls">
        <span id="console-mode-pill" class="mode-pill font-mono" data-mode="syncing">
          SYNCING CORE...
        </span>
        <button id="refresh-overview-btn" type="button" class="btn btn-sm" data-magnetic>
          Sync State
        </button>
      </div>
    </div>

    <div id="offline-banner" class="offline-banner font-mono" hidden>
      <span>
        CORE UNREACHABLE AT <strong>127.0.0.1:8080</strong> — RUNNING IN LOCAL MONOCHROME DEMO MODE
      </span>
      <button id="retry-connect-btn" type="button" class="retry-link">RETRY</button>
    </div>

    <!-- Telemetry Metrics Strip -->
    <div class="metrics-grid glass-surface" data-reveal style="--reveal-delay: 80ms">
      <div class="metric-cell">
        <span class="metric-label font-mono">ACTIVE NODES</span>
        <span class="metric-value font-display" id="metric-active">-- / --</span>
      </div>
      <div class="metric-cell">
        <span class="metric-label font-mono">TOTAL LOAD</span>
        <span class="metric-value font-display" id="metric-power">-- W</span>
      </div>
      <div class="metric-cell">
        <span class="metric-label font-mono">CORE UPTIME</span>
        <span class="metric-value font-display" id="metric-uptime">--</span>
      </div>
      <div class="metric-cell">
        <span class="metric-label font-mono">ACTIVE SCENE</span>
        <span class="metric-value font-display" id="metric-scene">CUSTOM</span>
      </div>
    </div>

    <!-- Scene Orchestration Bar -->
    <div id="scenes" class="scenes-block" data-reveal style="--reveal-delay: 140ms">
      <div class="block-header">
        <span class="font-mono block-title">SCENE PRESETS</span>
        <span class="font-mono block-hint">ONE-TOUCH ENVIRONMENT ORCHESTRATION</span>
      </div>
      <div id="scenes-grid" class="scenes-grid" role="group" aria-label="Smart home scenes">
        <!-- Populated dynamically -->
      </div>
    </div>

    <!-- Room Filter & Devices -->
    <div class="devices-block" data-reveal style="--reveal-delay: 180ms">
      <div class="devices-toolbar">
        <div id="room-tabs" class="room-tabs" role="tablist" aria-label="Filter devices by room">
          <button type="button" class="room-tab is-active font-mono" data-room="all" role="tab" aria-selected="true">
            ALL ZONES
          </button>
        </div>
        <div class="toolbar-right">
          <span id="device-count-label" class="font-mono block-hint">0 NODES</span>
          <button id="open-add-device-btn" type="button" class="btn btn-primary btn-sm">
            + Add Device
          </button>
        </div>
      </div>

      <div id="devices-grid" class="devices-grid">
        <!-- Populated dynamically -->
      </div>
    </div>

    <!-- Autonomous IF/THEN Rules Engine -->
    <div id="automations" class="automations-block" data-reveal style="--reveal-delay: 220ms">
      <div class="devices-toolbar">
        <div>
          <span class="font-mono block-title">AUTONOMOUS IF / THEN RULES</span>
          <p class="block-sub">Trigger multi-device cascades automatically when node states change.</p>
        </div>
        <div class="toolbar-right">
          <span id="automation-count-label" class="font-mono block-hint">0 RULES</span>
          <button id="open-add-automation-btn" type="button" class="btn btn-primary btn-sm">
            + New Automation
          </button>
        </div>
      </div>

      <div id="automations-grid" class="automations-grid">
        <!-- Populated dynamically -->
      </div>
    </div>
  </div>
</section>

<!-- Add Device Modal Sheet -->
<div id="add-device-modal" class="lh-modal-backdrop" hidden role="dialog" aria-modal="true" aria-labelledby="add-device-title">
  <div class="lh-modal">
    <div class="lh-modal-head">
      <div>
        <span class="font-mono modal-eyebrow">NODE REGISTRATION</span>
        <h3 id="add-device-title" class="font-display modal-title">Add Smart Device</h3>
      </div>
      <button type="button" class="modal-close-btn" data-close-modal="add-device-modal" aria-label="Close modal">✕</button>
    </div>

    <form id="add-device-form" class="lh-form">
      <div class="form-row">
        <label class="form-label" for="dev-name-input">Device Name</label>
        <input id="dev-name-input" class="form-input" type="text" placeholder="e.g. Studio Floor Lamp" required />
      </div>

      <div class="form-grid-2">
        <div class="form-row">
          <label class="form-label" for="dev-room-select">Room / Zone</label>
          <select id="dev-room-select" class="form-select" required></select>
        </div>
        <div class="form-row">
          <label class="form-label" for="dev-kind-select">Device Type</label>
          <select id="dev-kind-select" class="form-select" required>
            <option value="lighting">Lighting</option>
            <option value="climate">Climate (AC)</option>
            <option value="switch">Switch / Button</option>
            <option value="security">Security</option>
            <option value="energy">Energy</option>
          </select>
        </div>
      </div>

      <!-- Dynamic Type Settings -->
      <div id="dev-opts-lighting" class="form-subpanel">
        <div class="form-grid-2">
          <div class="form-row">
            <label class="form-label" for="dev-light-level">Initial Brightness (%)</label>
            <input id="dev-light-level" class="form-input" type="number" min="0" max="100" value="80" />
          </div>
          <div class="form-row">
            <label class="form-label" for="dev-light-kelvin">Color Temp (K)</label>
            <input id="dev-light-kelvin" class="form-input" type="number" min="2700" max="6500" step="100" value="3500" />
          </div>
        </div>
      </div>

      <div id="dev-opts-climate" class="form-subpanel" hidden>
        <div class="form-grid-3">
          <div class="form-row">
            <label class="form-label" for="dev-climate-temp">Target (°C)</label>
            <input id="dev-climate-temp" class="form-input" type="number" min="16" max="30" step="1" value="22" />
          </div>
          <div class="form-row">
            <label class="form-label" for="dev-climate-mode">Mode</label>
            <select id="dev-climate-mode" class="form-select">
              <option value="cool">Cool</option>
              <option value="heat">Heat</option>
              <option value="auto">Auto</option>
              <option value="fan">Fan</option>
            </select>
          </div>
          <div class="form-row">
            <label class="form-label" for="dev-climate-fan">Fan Speed</label>
            <select id="dev-climate-fan" class="form-select">
              <option value="low">Low</option>
              <option value="medium" selected>Medium</option>
              <option value="high">High</option>
            </select>
          </div>
        </div>
      </div>

      <div id="dev-opts-switch" class="form-subpanel" hidden>
        <div class="form-row">
          <label class="form-label" for="dev-switch-mode">Button Mode</label>
          <select id="dev-switch-mode" class="form-select">
            <option value="toggle">Toggle</option>
            <option value="momentary">Momentary</option>
            <option value="scene">Scene</option>
          </select>
        </div>
      </div>

      <div class="lh-modal-actions">
        <button type="button" class="btn btn-sm" data-close-modal="add-device-modal">Cancel</button>
        <button type="submit" class="btn btn-primary btn-sm">Create Device</button>
      </div>
    </form>
  </div>
</div>

<!-- New Automation Modal Sheet -->
<div id="add-automation-modal" class="lh-modal-backdrop" hidden role="dialog" aria-modal="true" aria-labelledby="add-auto-title">
  <div class="lh-modal lh-modal-lg">
    <div class="lh-modal-head">
      <div>
        <span class="font-mono modal-eyebrow">IF / THEN BUILDER</span>
        <h3 id="add-auto-title" class="font-display modal-title">New Autonomous Rule</h3>
      </div>
      <button type="button" class="modal-close-btn" data-close-modal="add-automation-modal" aria-label="Close modal">✕</button>
    </div>

    <form id="add-automation-form" class="lh-form">
      <div class="form-row">
        <label class="form-label" for="auto-name-input">Rule Name</label>
        <input id="auto-name-input" class="form-input" type="text" placeholder="e.g. Evening All-On Cascade" required />
      </div>

      <div class="form-subpanel">
        <span class="font-mono subpanel-badge">IF TRIGGER</span>
        <div class="form-grid-3">
          <div class="form-row">
            <label class="form-label" for="auto-trigger-device">Trigger Device</label>
            <select id="auto-trigger-device" class="form-select" required></select>
          </div>
          <div class="form-row">
            <label class="form-label" for="auto-trigger-cond">Condition</label>
            <select id="auto-trigger-cond" class="form-select" required>
              <option value="turns_on">Turns ON</option>
              <option value="turns_off">Turns OFF</option>
              <option value="level_above">Level Above (%)</option>
              <option value="temp_above">Temp Above (°C)</option>
            </select>
          </div>
          <div id="auto-trigger-val-wrap" class="form-row" hidden>
            <label class="form-label" for="auto-trigger-val">Threshold</label>
            <input id="auto-trigger-val" class="form-input" type="number" step="1" value="50" />
          </div>
        </div>
      </div>

      <div class="form-subpanel">
        <div class="subpanel-head">
          <span class="font-mono subpanel-badge">THEN ACTIONS</span>
          <button id="add-action-row-btn" type="button" class="pill-btn">+ Add Action</button>
        </div>
        <div id="auto-actions-container" class="actions-builder-list"></div>
      </div>

      <div class="lh-modal-actions">
        <button type="button" class="btn btn-sm" data-close-modal="add-automation-modal">Cancel</button>
        <button type="submit" class="btn btn-primary btn-sm">Save Automation</button>
      </div>
    </form>
  </div>
</div>

<style>
  .console-section {
    padding: clamp(4rem, 8vw, 6.5rem) 0;
    border-bottom: 1px solid var(--border);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .section-title {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 600;
    line-height: 1.05;
  }

  .head-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .mode-pill {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background-color: var(--bg-elevated);
    color: var(--fg-muted);
  }

  .mode-pill[data-mode='live'] {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .btn-sm {
    padding: 0.55rem 1.05rem;
    font-size: 0.76rem;
  }

  .offline-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.25rem;
    margin-bottom: 1.5rem;
    border-radius: var(--radius-inner);
    border: 1px dashed var(--border-strong);
    background-color: var(--bg-elevated);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
  }

  .offline-banner[hidden] {
    display: none;
  }

  .offline-banner strong {
    color: var(--fg);
  }

  .retry-link {
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--fg);
    font-family: inherit;
    font-size: 0.7rem;
    padding: 0.35rem 0.8rem;
    cursor: pointer;
    letter-spacing: 0.08em;
  }

  .retry-link:hover {
    background-color: var(--accent);
    color: var(--accent-fg);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    overflow: hidden;
    margin-bottom: 2.75rem;
  }

  @media (min-width: 768px) {
    .metrics-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .metric-cell {
    padding: 1.4rem 1.5rem;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  @media (min-width: 768px) {
    .metric-cell {
      border-bottom: none;
    }
    .metric-cell:last-child {
      border-right: none;
    }
  }

  .metric-label {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
  }

  .metric-value {
    font-size: clamp(1.35rem, 2.4vw, 1.95rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .block-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .block-title {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--fg);
    font-weight: 500;
  }

  .block-sub {
    font-size: 0.85rem;
    color: var(--fg-muted);
    margin-top: 0.25rem;
  }

  .block-hint {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
  }

  .scenes-block {
    margin-bottom: 3rem;
  }

  .scenes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }

  :global(.scene-card) {
    text-align: left;
    padding: 1.35rem 1.45rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    background-color: var(--bg-elevated);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow: var(--shadow-soft);
    color: var(--fg);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    transition:
      transform 0.3s var(--ease-spring),
      border-color 0.25s ease,
      background-color 0.25s ease,
      color 0.25s ease,
      box-shadow 0.3s var(--ease-spring);
  }

  :global(.scene-card:hover) {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  :global(.scene-card.is-active) {
    background-color: var(--accent);
    color: var(--accent-fg);
    border-color: var(--accent);
  }

  :global(.scene-card-top) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    width: 100%;
  }

  :global(.scene-name) {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  :global(.scene-state) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    border: 1px solid currentColor;
    opacity: 0.85;
  }

  :global(.scene-desc) {
    font-size: 0.85rem;
    line-height: 1.45;
    opacity: 0.78;
  }

  .devices-block {
    margin-bottom: 3.5rem;
  }

  .devices-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.35rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .room-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  :global(.room-tab) {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--fg-muted);
    padding: 0.45rem 0.95rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: all 0.24s var(--ease-spring);
  }

  :global(.room-tab:hover) {
    border-color: var(--fg);
    color: var(--fg);
  }

  :global(.room-tab.is-active) {
    background-color: var(--accent);
    color: var(--accent-fg);
    border-color: var(--accent);
  }

  .devices-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 1.25rem;
  }

  :global(.device-card) {
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background-color: var(--bg-elevated);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow: var(--shadow-soft);
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.15rem;
    transition:
      transform 0.32s var(--ease-spring),
      border-color 0.25s ease,
      box-shadow 0.32s var(--ease-spring);
  }

  :global(.device-card:hover) {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }

  :global(.device-card.is-on) {
    border-color: var(--border-strong);
  }

  :global(.device-top) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  :global(.device-identity) {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  :global(.device-icon-badge) {
    width: 40px;
    height: 40px;
    border-radius: 13px;
    border: 1px solid var(--border);
    background-color: var(--bg-subtle);
    color: var(--fg-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.28s var(--ease-spring);
  }

  :global(.device-card.is-on .device-icon-badge) {
    background-color: var(--accent);
    color: var(--accent-fg);
    border-color: var(--accent);
  }

  :global(.device-meta) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  :global(.device-kind) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  :global(.device-name) {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.device-top-actions) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  :global(.icon-trash-btn) {
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--fg-faint);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  :global(.icon-trash-btn:hover) {
    color: var(--fg);
    border-color: var(--border);
    background-color: var(--bg-subtle);
  }

  /* Apple iOS/macOS Sliding Toggle Switch */
  :global(.device-toggle) {
    position: relative;
    width: 50px;
    height: 28px;
    border-radius: 9999px;
    border: 1px solid var(--border-strong);
    background-color: var(--bg-subtle);
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color 0.28s var(--ease-spring), border-color 0.28s ease;
  }

  :global(.device-toggle::after) {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background-color: var(--fg-muted);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.28);
    transition: transform 0.28s var(--ease-spring), background-color 0.25s ease;
  }

  :global(.device-toggle[aria-pressed='true']) {
    background-color: var(--accent);
    border-color: var(--accent);
  }

  :global(.device-toggle[aria-pressed='true']::after) {
    transform: translateX(22px);
    background-color: var(--accent-fg);
  }

  /* Dedicated Device Controls */
  :global(.device-controls) {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  :global(.climate-temp-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-inner);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border);
  }

  :global(.climate-temp-display) {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.65rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  :global(.stepper-group) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  :global(.stepper-btn) {
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    border: 1px solid var(--border-strong);
    background-color: var(--bg-elevated);
    color: var(--fg);
    font-size: 1rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s var(--ease-spring);
  }

  :global(.stepper-btn:hover) {
    background-color: var(--accent);
    color: var(--accent-fg);
    border-color: var(--accent);
  }

  :global(.segmented-row) {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  :global(.control-caption) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  :global(.pill-group) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  :global(.pill-opt) {
