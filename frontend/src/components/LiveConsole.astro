    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .lh-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.85rem;
  }

  .form-grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--fg-muted);
  }

  .form-input,
  .form-select {
    width: 100%;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-inner);
    border: 1px solid var(--border-strong);
