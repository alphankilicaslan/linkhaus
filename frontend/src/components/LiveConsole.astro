  .form-select option {
    background-color: var(--bg-solid);
    color: var(--fg);
  }

  .form-subpanel {
    padding: 1rem;
    border-radius: var(--radius-inner);
    border: 1px solid var(--border);
    background-color: var(--bg-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .form-subpanel[hidden] {
    display: none;
  }

  .subpanel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .subpanel-badge {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
  }

  .actions-builder-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  :global(.action-builder-row) {
    display: grid;
    grid-template-columns: 1fr 1fr auto auto;
    gap: 0.5rem;
    align-items: center;
  }

  .lh-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }
</style>

<script>
  import {
    activateScene,
    createAutomation,
    createDevice,
    deleteAutomation,
    deleteDevice,
    fetchOverview,
    OFFLINE_FALLBACK_OVERVIEW,
    runAutomation,
    toggleAutomation,
    toggleDevice,
    updateDevice,
    type AutomationRule,
    type CreateDeviceRequest,
    type Device,
    type OverviewResponse,
    type RuleAction,
    type Scene,
    type UpdateDeviceRequest,
  } from '../lib/api';
  import { getDeviceIconSvg, PLAY_ICON_SVG, TRASH_ICON_SVG } from '../lib/icons';

  const isSceneActive = (scene: Scene): boolean => Boolean(scene.is_active ?? scene.active);

  let state: OverviewResponse = structuredClone(OFFLINE_FALLBACK_OVERVIEW);
  let isLive = false;
  let activeRoom = 'all';
  const sliderTimers = new Map<string, number>();

  const modePill = document.getElementById('console-mode-pill');
  const offlineBanner = document.getElementById('offline-banner');
  const metricActive = document.getElementById('metric-active');
  const metricPower = document.getElementById('metric-power');
  const metricUptime = document.getElementById('metric-uptime');
  const metricScene = document.getElementById('metric-scene');
  const scenesGrid = document.getElementById('scenes-grid');
  const roomTabs = document.getElementById('room-tabs');
  const devicesGrid = document.getElementById('devices-grid');
  const deviceCountLabel = document.getElementById('device-count-label');
  const automationsGrid = document.getElementById('automations-grid');
  const automationCountLabel = document.getElementById('automation-count-label');

  function formatUptime(secs: number): string {
    if (!secs || secs <= 0) return 'DEMO';
    const h = Math.floor(secs / 3600);
    const m = Math.floor((secs % 3600) / 60);
    const s = secs % 60;
    if (h > 0) return `${h}h ${m}m`;
    if (m > 0) return `${m}m ${s}s`;
    return `${s}s`;
  }

  function recomputeLocalMetrics() {
    const activeCount = state.devices.filter((d) => d.is_on).length;
    const totalPower = state.devices.reduce((acc, d) => acc + (d.is_on ? d.power_watts : 0), 0);
    state.metrics.active_devices = activeCount;
    state.metrics.total_devices = state.devices.length;
    state.metrics.power_watts = totalPower;
  }

  function getDeviceName(deviceId: string): string {
    return state.devices.find((d) => d.id === deviceId)?.name ?? deviceId;
  }

  function getRoomName(roomId: string): string {
    return state.rooms.find((r) => r.id === roomId)?.name ?? roomId;
  }

  function applyRuleActionsLocally(actions: RuleAction[]) {
    for (const act of actions) {
      state.devices = state.devices.map((d) => {
        if (d.id !== act.target_device_id) return d;
        if (act.action === 'turn_on') return { ...d, is_on: true };
        if (act.action === 'turn_off') return { ...d, is_on: false };
        if (act.action === 'toggle') return { ...d, is_on: !d.is_on };
        if (act.action === 'set_level' && typeof act.value === 'number') {
          return { ...d, is_on: true, level: act.value };
        }
        if (act.action === 'set_temp' && typeof act.value === 'number') {
          return { ...d, is_on: true, temperature_c: act.value };
        }
        return d;
      });
    }
  }

  function evaluateLocalAutomations(prev: Device, next: Device) {
    const rules = state.automations ?? [];
    for (const rule of rules) {
      if (!rule.enabled || rule.trigger_device_id !== next.id) continue;
      let matched = false;
      if (rule.trigger_condition === 'turns_on' && !prev.is_on && next.is_on) matched = true;
      if (rule.trigger_condition === 'turns_off' && prev.is_on && !next.is_on) matched = true;
      if (
        rule.trigger_condition === 'level_above' &&
        typeof next.level === 'number' &&
        typeof rule.trigger_value === 'number' &&
        next.level > rule.trigger_value
      ) {
        matched = true;
      }
      if (
        rule.trigger_condition === 'temp_above' &&
        typeof next.temperature_c === 'number' &&
        typeof rule.trigger_value === 'number' &&
        next.temperature_c > rule.trigger_value
      ) {
        matched = true;
      }
      if (matched) {
        applyRuleActionsLocally(rule.actions);
      }
    }
  }

  function renderMetrics() {
    if (metricActive) {
      metricActive.textContent = `${state.metrics.active_devices} / ${state.metrics.total_devices}`;
    }
    if (metricPower) {
      metricPower.textContent = `${state.metrics.power_watts} W`;
    }
    if (metricUptime) {
      metricUptime.textContent = isLive ? formatUptime(state.metrics.uptime_secs) : 'LOCAL DEMO';
    }
    if (metricScene) {
      const currentScene = state.scenes.find(isSceneActive);
      metricScene.textContent = currentScene ? currentScene.name.toUpperCase() : 'CUSTOM';
    }
  }

  function renderScenes() {
    if (!scenesGrid) return;
    scenesGrid.innerHTML = '';

    for (const scene of state.scenes) {
      const active = isSceneActive(scene);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `scene-card${active ? ' is-active' : ''}`;
      btn.setAttribute('data-scene-id', scene.id);
      btn.innerHTML = `
        <div class="scene-card-top">
          <span class="scene-name">${scene.name}</span>
          <span class="scene-state">${active ? 'ACTIVE' : 'ACTIVATE'}</span>
        </div>
        <p class="scene-desc">${scene.description}</p>
      `;

      btn.addEventListener('click', async () => {
        if (isLive) {
          try {
            state = await activateScene(scene.id);
          } catch {
            isLive = false;
            updateConnectionUI();
          }
        } else {
          state.scenes = state.scenes.map((s) => ({
            ...s,
            is_active: s.id === scene.id,
            active: s.id === scene.id,
          }));
          if (scene.id === 'away-guard') {
            state.devices = state.devices.map((d) => ({
              ...d,
              is_on: d.kind.toLowerCase() === 'security',
            }));
          } else if (scene.id === 'monochrome-evening') {
            state.devices = state.devices.map((d) =>
              d.kind.toLowerCase() === 'lighting' ? { ...d, is_on: true, level: 35, color_temp_k: 2700 } : d
            );
          } else {
            state.devices = state.devices.map((d) =>
              d.kind.toLowerCase() === 'lighting' ? { ...d, is_on: true, level: 85, color_temp_k: 4500 } : d
            );
          }
          recomputeLocalMetrics();
        }
        renderAll();
      });

      scenesGrid.appendChild(btn);
    }
  }

  function renderRooms() {
    if (!roomTabs) return;
    roomTabs.innerHTML = '';

    const allBtn = document.createElement('button');
    allBtn.type = 'button';
    allBtn.className = `room-tab font-mono${activeRoom === 'all' ? ' is-active' : ''}`;
    allBtn.textContent = 'ALL ZONES';
    allBtn.addEventListener('click', () => {
      activeRoom = 'all';
      renderRooms();
      renderDevices();
    });
    roomTabs.appendChild(allBtn);

    for (const room of state.rooms) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `room-tab font-mono${activeRoom === room.id ? ' is-active' : ''}`;
      btn.textContent = room.name.toUpperCase();
      btn.addEventListener('click', () => {
        activeRoom = room.id;
        renderRooms();
        renderDevices();
      });
      roomTabs.appendChild(btn);
    }
  }

  async function patchAndSync(device: Device, patch: UpdateDeviceRequest) {
    const prev = { ...device };
    const optimistic = { ...device, ...patch };
    if (!isLive) {
      updateLocalDevice(optimistic);
      evaluateLocalAutomations(prev, optimistic);
      recomputeLocalMetrics();
      renderAll();
      return;
    }

    updateLocalDevice(optimistic);
    try {
      const updated = await updateDevice(device.id, patch);
      updateLocalDevice(updated);
      await syncOverviewQuietly();
    } catch {
      isLive = false;
      updateConnectionUI();
    }
  }

  function buildDedicatedControls(device: Device): string {
    const kind = device.kind.toLowerCase();

    if (kind === 'climate') {
      const temp = Math.round(device.temperature_c ?? 22);
      const mode = (device.climate_mode ?? 'cool').toLowerCase();
      const fan = (device.fan_speed ?? 'medium').toLowerCase();
      const modes = ['cool', 'heat', 'auto', 'fan'];
      const fans = [
        { id: 'low', label: 'Low' },
        { id: 'medium', label: 'Med' },
        { id: 'high', label: 'High' },
      ];
      return `
        <div class="device-controls">
          <div class="climate-temp-row">
            <div>
              <span class="control-caption">TARGET TEMP</span>
              <span class="climate-temp-display">${temp}°C</span>
            </div>
            <div class="stepper-group">
              <button type="button" class="stepper-btn" data-temp-delta="-1" aria-label="Decrease temperature">−</button>
              <button type="button" class="stepper-btn" data-temp-delta="1" aria-label="Increase temperature">+</button>
            </div>
          </div>
          <div class="segmented-row">
            <span class="control-caption">MODE</span>
            <div class="pill-group">
              ${modes
                .map(
                  (m) =>
                    `<button type="button" class="pill-opt${mode === m ? ' is-selected' : ''}" data-climate-mode="${m}">${m}</button>`
                )
                .join('')}
            </div>
          </div>
          <div class="segmented-row">
            <span class="control-caption">FAN SPEED</span>
            <div class="pill-group">
              ${fans
                .map(
                  (f) =>
                    `<button type="button" class="pill-opt${fan === f.id ? ' is-selected' : ''}" data-fan-speed="${f.id}">${f.label}</button>`
                )
                .join('')}
            </div>
          </div>
        </div>
      `;
    }

    if (kind === 'lighting') {
      const levelVal = device.level ?? 75;
      const kelvin = device.color_temp_k ?? 3400;
      return `
        <div class="device-controls">
          <div class="device-slider-wrap">
            <div class="control-caption">
              <span>BRIGHTNESS</span>
              <span class="device-level-val">${levelVal}%</span>
            </div>
            <input type="range" min="0" max="100" value="${levelVal}" class="lh-slider" data-slider="level" ${!device.is_on ? 'disabled' : ''} />
          </div>
          <div class="device-slider-wrap">
            <div class="control-caption">
              <span>COLOR TEMP</span>
              <span class="device-kelvin-val">${kelvin}K</span>
            </div>
            <input type="range" min="2700" max="6500" step="100" value="${kelvin}" class="lh-slider" data-slider="kelvin" ${!device.is_on ? 'disabled' : ''} />
            <div class="pill-group">
              <button type="button" class="pill-opt${kelvin <= 3000 ? ' is-selected' : ''}" data-kelvin-preset="2700">2700K</button>
              <button type="button" class="pill-opt${kelvin > 3000 && kelvin < 5200 ? ' is-selected' : ''}" data-kelvin-preset="4000">4000K</button>
              <button type="button" class="pill-opt${kelvin >= 5200 ? ' is-selected' : ''}" data-kelvin-preset="6500">6500K</button>
            </div>
          </div>
        </div>
      `;
    }

    if (kind === 'switch') {
      const bMode = (device.button_mode ?? 'toggle').toLowerCase();
      const modes = ['toggle', 'momentary', 'scene'];
      return `
        <div class="device-controls">
          <div class="segmented-row">
            <span class="control-caption">BUTTON MODE</span>
            <div class="pill-group">
              ${modes
                .map(
                  (m) =>
                    `<button type="button" class="pill-opt${bMode === m ? ' is-selected' : ''}" data-button-mode="${m}">${m}</button>`
                )
                .join('')}
            </div>
          </div>
          <button type="button" class="switch-action-pill${device.is_on ? ' is-active' : ''}" data-switch-pill>
            ${device.is_on ? 'STATE: ON — PRESS TO TURN OFF' : 'STATE: OFF — PRESS TO ACTIVATE'}
          </button>
        </div>
      `;
    }

    // Security / Energy / Generic
    if (typeof device.level === 'number') {
      return `
        <div class="device-controls">
          <div class="device-slider-wrap">
            <div class="control-caption">
              <span>${kind === 'energy' ? 'RESERVE / OUTPUT' : 'OUTPUT LEVEL'}</span>
              <span class="device-level-val">${device.level}${device.unit ?? '%'}</span>
            </div>
            <input type="range" min="0" max="100" value="${device.level}" class="lh-slider" data-slider="level" ${!device.is_on ? 'disabled' : ''} />
          </div>
        </div>
      `;
    }

    return '';
  }

  function renderDevices() {
    if (!devicesGrid) return;
    devicesGrid.innerHTML = '';

    const filtered =
      activeRoom === 'all' ? state.devices : state.devices.filter((d) => d.room_id === activeRoom);

    if (deviceCountLabel) {
      deviceCountLabel.textContent = `${filtered.length} ${filtered.length === 1 ? 'NODE' : 'NODES'}`;
    }

    for (const device of filtered) {
      const kind = device.kind.toLowerCase();
      const card = document.createElement('article');
      card.className = `device-card${device.is_on ? ' is-on' : ''}`;
      card.setAttribute('data-device-id', device.id);

      const statusLabel =
        kind === 'security' ? (device.is_on ? 'LOCKED' : 'UNLOCKED') : device.is_on ? 'ACTIVE' : 'STANDBY';

      card.innerHTML = `
        <div class="device-top">
          <div class="device-identity">
            <div class="device-icon-badge">${getDeviceIconSvg(kind)}</div>
            <div class="device-meta">
              <span class="device-kind">${kind} · ${getRoomName(device.room_id)}</span>
              <h3 class="device-name">${device.name}</h3>
            </div>
          </div>
          <div class="device-top-actions">
            <button type="button" class="icon-trash-btn" data-delete-device aria-label="Delete ${device.name}" title="Remove device">
              ${TRASH_ICON_SVG}
            </button>
            <button
              type="button"
              class="device-toggle"
              aria-label="Toggle ${device.name}"
              aria-pressed="${device.is_on ? 'true' : 'false'}"
            ></button>
          </div>
        </div>
        ${buildDedicatedControls(device)}
        <div class="device-bottom">
          <span class="device-status-text">${statusLabel}</span>
          <span>${device.is_on ? device.power_watts : 0} W</span>
        </div>
      `;

      const handleToggle = async () => {
        const prev = { ...device };
        const optimistic = { ...device, is_on: !device.is_on };
        updateLocalDevice(optimistic);

        if (isLive) {
          try {
            const updated = await toggleDevice(device.id);
            updateLocalDevice(updated);
            await syncOverviewQuietly();
          } catch {
            isLive = false;
            updateConnectionUI();
          }
        } else {
          evaluateLocalAutomations(prev, optimistic);
          recomputeLocalMetrics();
          renderAll();
        }
      };

      card.querySelector('.device-toggle')?.addEventListener('click', handleToggle);
      card.querySelector('[data-switch-pill]')?.addEventListener('click', handleToggle);

      card.querySelector('[data-delete-device]')?.addEventListener('click', async () => {
        if (isLive) {
          try {
            await deleteDevice(device.id);
            await syncOverviewQuietly();
            return;
          } catch {
            isLive = false;
            updateConnectionUI();
          }
        }
        state.devices = state.devices.filter((d) => d.id !== device.id);
        recomputeLocalMetrics();
        renderAll();
      });

      // Climate steppers
      card.querySelectorAll<HTMLButtonElement>('[data-temp-delta]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const delta = Number(btn.getAttribute('data-temp-delta') || 0);
          const current = Math.round(device.temperature_c ?? 22);
          const nextTemp = Math.min(30, Math.max(16, current + delta));
          patchAndSync(device, { temperature_c: nextTemp });
        });
      });

      card.querySelectorAll<HTMLButtonElement>('[data-climate-mode]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-climate-mode') || 'cool';
          patchAndSync(device, { climate_mode: mode });
        });
      });

      card.querySelectorAll<HTMLButtonElement>('[data-fan-speed]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const fan = btn.getAttribute('data-fan-speed') || 'medium';
          patchAndSync(device, { fan_speed: fan });
        });
      });

      // Lighting Kelvin presets
      card.querySelectorAll<HTMLButtonElement>('[data-kelvin-preset]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const kelvin = Number(btn.getAttribute('data-kelvin-preset') || 3400);
          patchAndSync(device, { color_temp_k: kelvin });
        });
      });

      // Switch button mode
      card.querySelectorAll<HTMLButtonElement>('[data-button-mode]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const bMode = btn.getAttribute('data-button-mode') || 'toggle';
          patchAndSync(device, { button_mode: bMode });
        });
      });

      // Level slider
      const levelSlider = card.querySelector<HTMLInputElement>('input[data-slider="level"]');
      const levelDisplay = card.querySelector<HTMLElement>('.device-level-val');
      if (levelSlider) {
        levelSlider.addEventListener('input', () => {
          const val = Number(levelSlider.value);
          if (levelDisplay) levelDisplay.textContent = `${val}${device.unit ?? '%'}`;
          const key = `${device.id}-level`;
          const existing = sliderTimers.get(key);
          if (existing) window.clearTimeout(existing);
          sliderTimers.set(
            key,
            window.setTimeout(() => patchAndSync(device, { level: val }), 140)
          );
        });
      }

      // Kelvin slider
      const kelvinSlider = card.querySelector<HTMLInputElement>('input[data-slider="kelvin"]');
      const kelvinDisplay = card.querySelector<HTMLElement>('.device-kelvin-val');
      if (kelvinSlider) {
        kelvinSlider.addEventListener('input', () => {
          const val = Number(kelvinSlider.value);
          if (kelvinDisplay) kelvinDisplay.textContent = `${val}K`;
          const key = `${device.id}-kelvin`;
          const existing = sliderTimers.get(key);
          if (existing) window.clearTimeout(existing);
          sliderTimers.set(
            key,
            window.setTimeout(() => patchAndSync(device, { color_temp_k: val }), 140)
          );
        });
      }

      devicesGrid.appendChild(card);
    }
  }

  function renderAutomations() {
    if (!automationsGrid) return;
    const rules = state.automations ?? [];
    automationsGrid.innerHTML = '';

    if (automationCountLabel) {
      automationCountLabel.textContent = `${rules.length} ${rules.length === 1 ? 'RULE' : 'RULES'}`;
    }

    for (const rule of rules) {
      const card = document.createElement('article');
      card.className = 'auto-card';
      const condText = rule.trigger_condition.replace(/_/g, ' ');
      const thresholdText =
        typeof rule.trigger_value === 'number' ? ` (${rule.trigger_value})` : '';

      card.innerHTML = `
        <div class="auto-card-top">
          <h4 class="auto-name">${rule.name}</h4>
          <button
            type="button"
            class="device-toggle"
            aria-label="Toggle rule ${rule.name}"
            aria-pressed="${rule.enabled ? 'true' : 'false'}"
          ></button>
        </div>
        <div class="auto-flow">
          <div class="auto-chip-row">
            <span class="auto-badge">IF</span>
            <span>${getDeviceName(rule.trigger_device_id)}</span>
            <span class="auto-action-tag">${condText}${thresholdText}</span>
          </div>
          <div class="auto-chip-row">
            <span class="auto-badge">THEN</span>
            ${rule.actions
              .map(
                (a) =>
                  `<span class="auto-action-tag">${getDeviceName(a.target_device_id)} → ${a.action.replace(/_/g, ' ')}${typeof a.value === 'number' ? ` (${a.value})` : ''}</span>`
              )
              .join('')}
          </div>
        </div>
        <div class="auto-card-footer">
          <button type="button" class="pill-btn" data-run-rule>
            ${PLAY_ICON_SVG} Test Run
          </button>
          <button type="button" class="icon-trash-btn" data-delete-rule aria-label="Delete rule ${rule.name}">
            ${TRASH_ICON_SVG}
          </button>
        </div>
      `;

      card.querySelector('.device-toggle')?.addEventListener('click', async () => {
        if (isLive) {
          try {
            await toggleAutomation(rule.id);
            await syncOverviewQuietly();
            return;
          } catch {
            isLive = false;
            updateConnectionUI();
          }
        }
        state.automations = (state.automations ?? []).map((r) =>
          r.id === rule.id ? { ...r, enabled: !r.enabled } : r
        );
        renderAutomations();
      });

      card.querySelector('[data-run-rule]')?.addEventListener('click', async () => {
        if (isLive) {
          try {
            state = await runAutomation(rule.id);
            renderAll();
            return;
          } catch {
            isLive = false;
            updateConnectionUI();
          }
        }
        applyRuleActionsLocally(rule.actions);
        recomputeLocalMetrics();
        renderAll();
      });

      card.querySelector('[data-delete-rule]')?.addEventListener('click', async () => {
        if (isLive) {
          try {
            await deleteAutomation(rule.id);
            await syncOverviewQuietly();
            return;
          } catch {
            isLive = false;
            updateConnectionUI();
          }
        }
        state.automations = (state.automations ?? []).filter((r) => r.id !== rule.id);
        renderAutomations();
      });

      automationsGrid.appendChild(card);
    }
  }

  function updateLocalDevice(updated: Device) {
    state.devices = state.devices.map((d) => (d.id === updated.id ? updated : d));
    recomputeLocalMetrics();
    renderMetrics();
    renderDevices();
  }

  function updateConnectionUI() {
    if (modePill) {
      modePill.setAttribute('data-mode', isLive ? 'live' : 'offline');
      modePill.textContent = isLive ? 'LIVE RUST CORE' : 'OFFLINE DEMO';
    }
    if (offlineBanner) {
      offlineBanner.hidden = isLive;
    }
  }

  function renderAll() {
    updateConnectionUI();
    renderMetrics();
    renderScenes();
    renderRooms();
    renderDevices();
    renderAutomations();
  }

  async function syncOverviewQuietly() {
    try {
      state = await fetchOverview();
      isLive = true;
    } catch {
      isLive = false;
    }
    renderAll();
  }

  async function loadOverview() {
    if (modePill) modePill.textContent = 'SYNCING...';
    await syncOverviewQuietly();
  }

  // Modal helpers
  function openModal(id: string) {
    const el = document.getElementById(id);
    if (el) el.hidden = false;
  }

  function closeModal(id: string) {
    const el = document.getElementById(id);
    if (el) el.hidden = true;
  }

  document.querySelectorAll<HTMLElement>('[data-close-modal]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-close-modal');
      if (target) closeModal(target);
    });
  });

  // Add Device Modal logic
  const devKindSelect = document.getElementById('dev-kind-select') as HTMLSelectElement | null;
  const devRoomSelect = document.getElementById('dev-room-select') as HTMLSelectElement | null;
  const addDeviceForm = document.getElementById('add-device-form') as HTMLFormElement | null;

  function syncDeviceTypeOptions() {
    const kind = devKindSelect?.value ?? 'lighting';
    const lightOpts = document.getElementById('dev-opts-lighting');
    const climateOpts = document.getElementById('dev-opts-climate');
    const switchOpts = document.getElementById('dev-opts-switch');
    if (lightOpts) lightOpts.hidden = kind !== 'lighting';
    if (climateOpts) climateOpts.hidden = kind !== 'climate';
    if (switchOpts) switchOpts.hidden = kind !== 'switch';
  }

  devKindSelect?.addEventListener('change', syncDeviceTypeOptions);

  document.getElementById('open-add-device-btn')?.addEventListener('click', () => {
    if (devRoomSelect) {
      devRoomSelect.innerHTML = state.rooms
        .map((r) => `<option value="${r.id}">${r.name}</option>`)
        .join('');
    }
    syncDeviceTypeOptions();
    openModal('add-device-modal');
  });

  addDeviceForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (document.getElementById('dev-name-input') as HTMLInputElement).value.trim();
    const room_id = (document.getElementById('dev-room-select') as HTMLSelectElement).value;
    const kind = (document.getElementById('dev-kind-select') as HTMLSelectElement).value;

    const payload: CreateDeviceRequest = { name, room_id, kind };
    if (kind === 'lighting') {
      payload.level = Number((document.getElementById('dev-light-level') as HTMLInputElement).value || 80);
      payload.color_temp_k = Number((document.getElementById('dev-light-kelvin') as HTMLInputElement).value || 3500);
    } else if (kind === 'climate') {
      payload.temperature_c = Number((document.getElementById('dev-climate-temp') as HTMLInputElement).value || 22);
      payload.climate_mode = (document.getElementById('dev-climate-mode') as HTMLSelectElement).value;
      payload.fan_speed = (document.getElementById('dev-climate-fan') as HTMLSelectElement).value;
    } else if (kind === 'switch') {
      payload.button_mode = (document.getElementById('dev-switch-mode') as HTMLSelectElement).value;
    }

    if (isLive) {
      try {
        await createDevice(payload);
        await syncOverviewQuietly();
        addDeviceForm.reset();
        closeModal('add-device-modal');
        return;
      } catch {
        isLive = false;
        updateConnectionUI();
      }
    }

    const demoDevice: Device = {
      id: `demo-${Date.now()}`,
      name: payload.name,
      room_id: payload.room_id,
      kind: payload.kind,
      is_on: true,
      level: payload.level ?? null,
      power_watts: payload.kind === 'climate' ? 95 : 18,
      temperature_c: payload.temperature_c ?? null,
      climate_mode: payload.climate_mode ?? null,
      fan_speed: payload.fan_speed ?? null,
      color_temp_k: payload.color_temp_k ?? null,
      button_mode: payload.button_mode ?? null,
    };
    state.devices = [...state.devices, demoDevice];
    recomputeLocalMetrics();
    renderAll();
    addDeviceForm.reset();
    closeModal('add-device-modal');
  });

  // New Automation Modal logic
  const autoTriggerDevice = document.getElementById('auto-trigger-device') as HTMLSelectElement | null;
  const autoTriggerCond = document.getElementById('auto-trigger-cond') as HTMLSelectElement | null;
  const autoTriggerValWrap = document.getElementById('auto-trigger-val-wrap');
  const autoActionsContainer = document.getElementById('auto-actions-container');
  const addAutomationForm = document.getElementById('add-automation-form') as HTMLFormElement | null;

  autoTriggerCond?.addEventListener('change', () => {
    const cond = autoTriggerCond.value;
    if (autoTriggerValWrap) {
      autoTriggerValWrap.hidden = cond !== 'level_above' && cond !== 'temp_above';
    }
  });

  function appendActionRow() {
    if (!autoActionsContainer) return;
    const row = document.createElement('div');
    row.className = 'action-builder-row';
    const devOpts = state.devices.map((d) => `<option value="${d.id}">${d.name}</option>`).join('');
    row.innerHTML = `
      <select class="form-select" data-act-target>${devOpts}</select>
      <select class="form-select" data-act-type>
        <option value="turn_on">Turn ON</option>
        <option value="turn_off">Turn OFF</option>
        <option value="toggle">Toggle</option>
        <option value="set_level">Set Level</option>
        <option value="set_temp">Set Temp</option>
      </select>
      <input type="number" class="form-input" data-act-val placeholder="Val" style="width: 74px" hidden />
      <button type="button" class="icon-trash-btn" data-remove-row aria-label="Remove action">${TRASH_ICON_SVG}</button>
    `;

    const actType = row.querySelector('[data-act-type]') as HTMLSelectElement;
    const actVal = row.querySelector('[data-act-val]') as HTMLInputElement;
    actType.addEventListener('change', () => {
      actVal.hidden = actType.value !== 'set_level' && actType.value !== 'set_temp';
    });
    row.querySelector('[data-remove-row]')?.addEventListener('click', () => row.remove());
    autoActionsContainer.appendChild(row);
  }

  document.getElementById('add-action-row-btn')?.addEventListener('click', appendActionRow);

  document.getElementById('open-add-automation-btn')?.addEventListener('click', () => {
    if (autoTriggerDevice) {
      autoTriggerDevice.innerHTML = state.devices
        .map((d) => `<option value="${d.id}">${d.name}</option>`)
        .join('');
    }
    if (autoActionsContainer) {
      autoActionsContainer.innerHTML = '';
      appendActionRow();
    }
    openModal('add-automation-modal');
  });

  addAutomationForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = (document.getElementById('auto-name-input') as HTMLInputElement).value.trim();
    const trigger_device_id = autoTriggerDevice?.value ?? '';
    const trigger_condition = autoTriggerCond?.value ?? 'turns_on';
    const triggerValEl = document.getElementById('auto-trigger-val') as HTMLInputElement;
    const needsTriggerVal = trigger_condition === 'level_above' || trigger_condition === 'temp_above';
    const trigger_value = needsTriggerVal ? Number(triggerValEl.value || 50) : undefined;

    const actions: RuleAction[] = [];
    autoActionsContainer?.querySelectorAll('.action-builder-row').forEach((row) => {
      const target_device_id = (row.querySelector('[data-act-target]') as HTMLSelectElement).value;
      const action = (row.querySelector('[data-act-type]') as HTMLSelectElement).value;
      const valInput = row.querySelector('[data-act-val]') as HTMLInputElement;
      const value = !valInput.hidden && valInput.value !== '' ? Number(valInput.value) : undefined;
      actions.push({ target_device_id, action, value });
    });

    if (actions.length === 0) return;

    if (isLive) {
      try {
        await createAutomation({ name, trigger_device_id, trigger_condition, trigger_value, actions });
        await syncOverviewQuietly();
        addAutomationForm.reset();
        closeModal('add-automation-modal');
        return;
      } catch {
        isLive = false;
        updateConnectionUI();
      }
    }

    const demoRule: AutomationRule = {
      id: `demo-rule-${Date.now()}`,
      name,
      enabled: true,
      trigger_device_id,
      trigger_condition,
      trigger_value,
      actions,
    };
    state.automations = [...(state.automations ?? []), demoRule];
    renderAutomations();
    addAutomationForm.reset();
    closeModal('add-automation-modal');
  });

  document.getElementById('refresh-overview-btn')?.addEventListener('click', loadOverview);
  document.getElementById('retry-connect-btn')?.addEventListener('click', loadOverview);

  loadOverview();
</script>
