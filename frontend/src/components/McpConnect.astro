---
const mcpTools = [
  { name: 'linkhaus_health', desc: 'Check Rust core health & version' },
  { name: 'linkhaus_overview', desc: 'Read rooms, devices, scenes, metrics & rules' },
  { name: 'linkhaus_toggle_device', desc: 'Toggle device ON/OFF & fire IF/THEN rules' },
  { name: 'linkhaus_update_device', desc: 'Set level, temp °C, mode, fan, Kelvin, button mode' },
  { name: 'linkhaus_create_device', desc: 'Register a new smart home node' },
  { name: 'linkhaus_delete_device', desc: 'Remove a device node by ID' },
  { name: 'linkhaus_activate_scene', desc: 'Activate Monochrome Evening, Focus, or Away Guard' },
  { name: 'linkhaus_list_automations', desc: 'Inspect all IF/THEN automation rules' },
  { name: 'linkhaus_create_automation', desc: 'Create multi-action IF/THEN cascade rules' },
  { name: 'linkhaus_run_automation', desc: 'Manually trigger an automation rule' },
];

const mcpSnippet = `{
  "mcpServers": {
    "linkhaus": {
      "command": "node",
      "args": [
        "C:/Users/Alphan.MonsterAlphan/.gemini/antigravity/scratch/linkhaus/mcp/dist/index.js"
      ],
      "env": {
        "LINKHAUS_API_URL": "http://127.0.0.1:8080"
      }
    }
  }
}`;
---

<section id="mcp" class="mcp-section">
  <div class="container">
    <div class="mcp-head" data-reveal>
      <div>
        <span class="section-label">03 // AI &amp; MODEL CONTEXT PROTOCOL</span>
        <h2 class="mcp-title font-display">Connect AI Assistants to LinkHaus.</h2>
        <p class="mcp-subtitle">
          Expose every room, climate controller, light, switch, and IF/THEN rule to Claude Desktop,
          Antigravity, or Cursor over local stdio MCP (`mcp/`).
        </p>
      </div>
    </div>

    <div class="mcp-grid">
      <article class="mcp-card glass-surface" data-reveal style="--reveal-delay: 60ms">
        <div class="mcp-card-top">
          <div class="mcp-icon-wrap" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l1.9 4.6L18.5 9.5l-4.6 1.9L12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z" />
              <path d="M5 18l.8 1.7L7.5 20.5l-1.7.8L5 23l-.8-1.7L2.5 20.5l1.7-.8L5 18z" />
              <path d="M19 16l.7 1.3 1.3.7-1.3.7L19 20l-.7-1.3-1.3-.7 1.3-.7L19 16z" />
            </svg>
          </div>
          <div>
            <span class="font-mono mcp-eyebrow">AVAILABLE MCP TOOLS (10)</span>
            <h3 class="mcp-card-title font-display">Direct Natural-Language Control</h3>
          </div>
        </div>

        <ul class="mcp-tools-list">
          {
            mcpTools.map((tool) => (
              <li class="mcp-tool-item">
                <code class="mcp-tool-name font-mono">{tool.name}</code>
                <span class="mcp-tool-desc">{tool.desc}</span>
              </li>
            ))
          }
        </ul>
      </article>

      <article class="mcp-card glass-surface" data-reveal style="--reveal-delay: 140ms">
        <div class="mcp-card-header-row">
          <div class="mcp-card-top">
            <div class="mcp-icon-wrap" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6" />
                <polyline points="8 6 2 12 8 18" />
              </svg>
            </div>
            <div>
              <span class="font-mono mcp-eyebrow">MCP_CONFIG.JSON</span>
              <h3 class="mcp-card-title font-display">Claude / Antigravity / Cursor</h3>
            </div>
          </div>

          <button id="copy-mcp-btn" type="button" class="btn btn-sm-pill" data-snippet={mcpSnippet}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="3" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <span id="copy-mcp-label">Copy Config</span>
          </button>
        </div>

        <pre class="mcp-code font-mono"><code>{mcpSnippet}</code></pre>

        <div class="mcp-steps font-mono">
          <span>1. Build server: <code>cd mcp &amp;&amp; npm install &amp;&amp; npm run build</code></span>
          <span>2. Ensure Rust core is running on <code>127.0.0.1:8080</code></span>
          <span>3. Paste snippet into your AI client&apos;s MCP config</span>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .mcp-section {
    padding: clamp(4rem, 8vw, 6.5rem) 0;
    border-bottom: 1px solid var(--border);
  }

  .mcp-head {
    margin-bottom: 2.5rem;
  }

  .mcp-title {
    margin-top: 0.75rem;
    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 600;
    line-height: 1.06;
  }

  .mcp-subtitle {
    margin-top: 0.85rem;
    font-size: 1rem;
    color: var(--fg-muted);
    max-width: 58ch;
    line-height: 1.6;
  }

  .mcp-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.35rem;
  }

  @media (min-width: 960px) {
    .mcp-grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  .mcp-card {
    padding: clamp(1.5rem, 2.8vw, 2.15rem);
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .mcp-card-header-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mcp-card-top {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .mcp-icon-wrap {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    border: 1px solid var(--border);
    background-color: var(--bg-subtle);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mcp-eyebrow {
    display: block;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
  }

  .mcp-card-title {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .mcp-tools-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.55rem;
  }

  @media (min-width: 600px) {
    .mcp-tools-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .mcp-tool-item {
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-inner);
    border: 1px solid var(--border);
    background-color: var(--bg-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mcp-tool-name {
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--fg);
  }

  .mcp-tool-desc {
    font-size: 0.78rem;
    color: var(--fg-muted);
    line-height: 1.35;
  }

  .btn-sm-pill {
    padding: 0.48rem 0.95rem;
    font-size: 0.76rem;
    border-radius: var(--radius-pill);
  }

  .mcp-code {
    padding: 1.15rem;
    border-radius: var(--radius-inner);
    border: 1px solid var(--border);
    background-color: var(--bg-subtle);
    font-size: 0.76rem;
    line-height: 1.55;
    overflow-x: auto;
    color: var(--fg);
  }

  .mcp-steps {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: var(--fg-muted);
  }

  .mcp-steps code {
    color: var(--fg);
    background-color: var(--bg-subtle);
    padding: 0.12rem 0.4rem;
    border-radius: 6px;
  }
</style>

<script>
  const copyBtn = document.getElementById('copy-mcp-btn') as HTMLButtonElement | null;
  const copyLabel = document.getElementById('copy-mcp-label');

  copyBtn?.addEventListener('click', async () => {
    const snippet = copyBtn.getAttribute('data-snippet') || '';
    try {
      await navigator.clipboard.writeText(snippet);
      if (copyLabel) copyLabel.textContent = 'Copied!';
      window.setTimeout(() => {
        if (copyLabel) copyLabel.textContent = 'Copy Config';
      }, 1800);
    } catch {
      if (copyLabel) copyLabel.textContent = 'Copy failed';
    }
  });
</script>
