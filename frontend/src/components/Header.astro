---
---

<header class="lh-header" id="top-header">
  <div class="container header-inner">
    <a href="#" class="brand" aria-label="LinkHaus by Helios Smart Systems">
      <svg class="brand-mark" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="2" y="2" width="20" height="20" stroke="currentColor" stroke-width="1.5" />
        <line x1="2" y1="12" x2="22" y2="12" stroke="currentColor" stroke-width="1.2" />
        <line x1="12" y1="2" x2="12" y2="22" stroke="currentColor" stroke-width="1.2" />
        <circle cx="12" cy="12" r="2.5" fill="currentColor" />
      </svg>
      <div class="brand-text">
        <span class="brand-name font-display">LINKHAUS</span>
        <span class="brand-sub font-mono">HELIOS SMART SYSTEMS</span>
      </div>
    </a>

    <nav class="header-nav" aria-label="Primary navigation">
      <a href="#console" class="nav-link">Console</a>
      <a href="#scenes" class="nav-link">Scenes</a>
      <a href="#automations" class="nav-link">Automations</a>
      <a href="#mcp" class="nav-link">AI &amp; MCP</a>
      <a href="#architecture" class="nav-link">Architecture</a>
    </nav>

    <div class="header-actions">
      <div
        id="health-badge"
        class="health-badge font-mono"
        data-status="checking"
        title="Backend connection status (http://127.0.0.1:8080/api/health)"
      >
        <span class="health-dot" aria-hidden="true"></span>
        <span id="health-label">CONNECTING</span>
      </div>

      <button
        id="theme-toggle"
        type="button"
        class="theme-toggle"
        aria-label="Toggle dark or light monochrome theme"
        data-magnetic
      >
        <span class="theme-icon-sun" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <circle cx="12" cy="12" r="4.5" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
        </span>
        <span class="theme-icon-moon" aria-hidden="true">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </span>
        <span id="theme-label" class="font-mono">DARK</span>
      </button>
    </div>
  </div>
</header>

<style>
  .lh-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--bg-glass);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--border);
    transition: background-color 0.35s var(--ease-spring), border-color 0.35s var(--ease-spring);
  }

  .header-inner {
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--fg);
  }

  .brand-mark {
    flex-shrink: 0;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand:hover .brand-mark {
    transform: rotate(90deg);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.16em;
  }

  .brand-sub {
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
  }

  .header-nav {
    display: none;
    align-items: center;
    gap: 2rem;
  }

  @media (min-width: 820px) {
    .header-nav {
      display: flex;
    }
  }

  .nav-link {
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--fg-muted);
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--fg);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .health-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.42rem 0.85rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background-color: var(--bg-elevated);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
    transition: border-color 0.25s ease, color 0.25s ease;
  }

  .health-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--fg-muted);
  }

  .health-badge[data-status='online'] {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .health-badge[data-status='online'] .health-dot {
    background-color: var(--fg);
    box-shadow: 0 0 8px var(--fg);
    animation: pulse-dot 2.2s infinite ease-in-out;
  }

  .health-badge[data-status='offline'] .health-dot {
    background-color: transparent;
    border: 1px solid var(--fg-muted);
  }

  @keyframes pulse-dot {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.8);
    }
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.44rem 0.85rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    background-color: var(--bg-elevated);
    color: var(--fg);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.22s var(--ease-spring);
  }

  .theme-toggle:hover {
    background-color: var(--bg-subtle);
    border-color: var(--fg);
  }

  :global([data-theme='dark']) .theme-icon-sun {
    display: none;
  }
  :global([data-theme='light']) .theme-icon-moon {
    display: none;
  }
</style>

<script>
  import { fetchHealth } from '../lib/api';

  const toggleBtn = document.getElementById('theme-toggle');
  const themeLabel = document.getElementById('theme-label');

  function syncThemeLabel(theme: string) {
    if (themeLabel) {
      themeLabel.textContent = theme.toUpperCase();
    }
  }

  const initialTheme = document.documentElement.getAttribute('data-theme') || 'dark';
  syncThemeLabel(initialTheme);

  toggleBtn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem('linkhaus-theme', next);
    } catch {
      // ignore storage restrictions
    }
    syncThemeLabel(next);
    window.dispatchEvent(new CustomEvent('linkhaus:theme-change', { detail: { theme: next } }));
  });

  const badge = document.getElementById('health-badge');
  const healthLabel = document.getElementById('health-label');

  async function checkHealth() {
    if (!badge || !healthLabel) return;
    try {
      const data = await fetchHealth();
      badge.setAttribute('data-status', 'online');
      healthLabel.textContent = `CORE ${data.version ?? 'ONLINE'}`;
    } catch {
      badge.setAttribute('data-status', 'offline');
      healthLabel.textContent = 'DEMO / OFFLINE';
    }
  }

  checkHealth();
  setInterval(checkHealth, 15000);
</script>
